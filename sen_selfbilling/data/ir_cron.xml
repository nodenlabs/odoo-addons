<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Vía normal: disparo al validar la entrega. La pasada cubre reintentos. -->
        <record id="ir_cron_selfbilling_auto_invoice" model="ir.cron">
            <field name="name">Autofacturación: facturar y timbrar ventas entregadas</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._cron_selfbilling_auto_invoice()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">15</field>
            <field name="interval_type">minutes</field>
            <field name="active" eval="True"/>
        </record>

        <record id="action_selfbilling_auto_invoice" model="ir.actions.server">
            <field name="name">Facturar, timbrar y enviar al cliente</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">list,form</field>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]"/>
            <field name="state">code</field>
            <field name="code">records.action_selfbilling_auto_invoice()</field>
        </record>
    </data>
</odoo>
